# Copy to .env and fill in. .env is git-ignored.

# Free key from https://opendata.transport.nsw.gov.au
NSW_TRANSPORT_OPENDATA_API=

# Trains: "stopID:Label,..." in travel order. You board at the first stop; trains must run through to the last.
# Each stop after the first gets an arrival-time column (2-3 stops fit on screen).
# Find stop IDs with the Trip Planner API's stop_finder, or the stop pages on transportnsw.info.
TRAIN_STOPS=213510:Strathfield,200060:Central,200070:Town Hall

# Weather, from BOM's public FTP files (ftp://ftp.bom.gov.au/anon/gen/fwo/).
# Town forecasts per state: IDN11060 (NSW), IDV10753 (VIC), IDQ11295 (QLD) ... AREA is the town's name in that file.
BOM_FORECAST_FILE=IDN11060
BOM_FORECAST_AREA=Sydney
# Latest station readings per state: IDN60920 (NSW), IDV60920 (VIC), IDQ60920 (QLD) ... STATION is its name in that file.
BOM_OBS_FILE=IDN60920
BOM_STATION=Sydney - Observatory Hill
